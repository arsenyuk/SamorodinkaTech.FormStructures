@page "/Directories/Details/{formNumber}/{version:int}/{id}"
@model SamorodinkaTech.FormStructures.Web.Pages.Directories.DetailsModel
@{
    ViewData["Title"] = "Reference book";
}

@if (Model.Book is null)
{
    <div class="alert alert-danger">Reference book not found.</div>
    <a class="btn btn-secondary" asp-page="/Directories/Index">Back</a>
}
else
{
    <div class="d-flex justify-content-between align-items-start gap-3">
        <div>
            <h1 class="mb-1">@Model.Book.Title</h1>
            <div class="text-muted">Form: <a href="/forms/@Uri.EscapeDataString(Model.FormNumber)">@Model.FormNumber</a>, version v@Model.Version</div>
            <div class="text-muted">Source: @Model.Book.SourceFormula</div>
        </div>
        <div>
            <a class="btn btn-secondary" asp-page="/Directories/Index">Back</a>
        </div>
    </div>

    <hr />

    <div class="mb-2">
        <span class="badge text-bg-primary">@Model.Book.Values.Count values</span>
    </div>

    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th style="width: 80px;">#</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
        @for (var i = 0; i < Model.Book.Values.Count; i++)
        {
            <tr>
                <td>@(i + 1)</td>
                <td>@Model.Book.Values[i]</td>
            </tr>
        }
        </tbody>
    </table>
}
